{
  "name": "esa-maven",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "阿里云 ESA Workers Maven 快照仓库代理（只代理，不存储）",
  "author": {
    "name": "徐晓伟",
    "email": "xuxiaowei@xuxiaowei.com.cn",
    "url": "https://www.xuxiaowei.com.cn"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xuxiaowei-com-cn/esa-maven.git"
  },
  "scripts": {
    "build": "node --check src/index.js && node --check src/maven-proxy.js && node --check src/config.js && node --check src/base64.js",
    "dev": "esa-cli dev",
    "dev:local": "node scripts/dev-server.mjs",
    "commit": "esa-cli commit",
    "deploy": "esa-cli deploy",
    "test": "node --test test/*.test.js"
  },
  "devDependencies": {
    "esa-cli": "^1.0.13"
  },
  "engines": {
    "node": ">=20"
  }
}
